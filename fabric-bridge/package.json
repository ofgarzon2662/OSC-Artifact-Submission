{
  "name": "fabric-bridge",
  "version": "0.1.0",
  "description": "Fabric client bridge microservice (TypeScript) to submit/update artifacts via Hyperledger Fabric Gateway SDK (stubbed for MVP)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests",
    "lint": "echo 'no linter configured yet'"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "8.7.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.4",
    "morgan": "^1.12.0",
    "uuid": "^11.1.1",
    "@grpc/grpc-js": "^1.9.7",
    "@hyperledger/fabric-gateway": "^1.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^2.0.16",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.7",
    "@types/node": "^20.14.11",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "body-parser": "1.20.8",
    "brace-expansion@^1": "1.1.18",
    "diff": "4.0.4",
    "js-yaml@^3": "3.15.2",
    "minimatch@^3": "3.1.5",
    "path-to-regexp": "0.1.13",
    "picomatch@^2": "2.3.2",
    "qs": "6.16.0"
  }
}
